{
  "name": "Macro Snap",
  "short_name": "Macros",
  "description": "Share a food photo, get calories and macros. Targets that adapt to your training.",
  "id": "/",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0f11",
  "theme_color": "#0d0f11",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "image", "accept": ["image/*"] }] }
  },
  "shortcuts": [
    { "name": "Snap", "short_name": "Snap", "url": "/#/today?add=photo", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Manual entry", "short_name": "Manual", "url": "/#/today?add=manual", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Food library", "short_name": "Foods", "url": "/#/foods", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
