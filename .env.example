# --- required in production ---
APP_TOKEN=change-me-to-a-long-random-string
PUBLIC_URL=https://your-domain.example

# --- Self-hosted store: SQLite file (used when no Couchbase is set) ---
# SQLITE_FILE=./data/macrosnap.db

# --- Couchbase Capella (optional hosted store) ---
COUCHBASE_CONNSTR=couchbases://cb.xxxxxxxx.cloud.couchbase.com
COUCHBASE_USERNAME=macrosnap
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=macrosnap
COUCHBASE_SCOPE=app

# --- Redis (omit to use an in-process cache) ---
REDIS_URL=rediss://default:password@host:6379

# --- OpenRouter (or paste a key in the app's Settings instead) ---
OPENROUTER_API_KEY=

# --- Strava (optional) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Hosted mode (multi-user; leave unset for self-hosted) ---
# MODE=hosted                    # needs SQLITE_FILE, PUBLIC_URL, OPENROUTER_API_KEY; no APP_TOKEN/TOKENS
# SESSION_SECRET=                # random, 32+ characters
# GOOGLE_CLIENT_ID=              # Google Cloud OAuth client (web); redirect URI: $PUBLIC_URL/api/auth/google/callback
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=                # magic-link emails; without it links are printed to the server log
# EMAIL_FROM=Macro Snap <login@your-domain.example>
# LEMONSQUEEZY_CHECKOUT_URL=     # the $20/year variant's checkout link
# LEMONSQUEEZY_WEBHOOK_SECRET=   # webhook URL: $PUBLIC_URL/api/billing/webhook (subscription_* events)
# PRICE_LABEL=$20/year
# FREE_PHOTOS=30                 # AI logs on the platform key before paying
# FREE_AI_CAP_USD=1              # platform AI spend before paying, whichever runs out first
# PAID_AI_CAP_USD=10             # platform AI spend per paid user per rolling year

# --- tuning (optional) ---
# JUDGE=jev            # Jev judge for food matching (uses OPENROUTER_API_KEY); default off
# JEV_MODEL=typesafe/jev-1.13
# TOKENS=tokenA=samridh,tokenB=friend
# FUZZY_AUTO=0.9
# FUZZY_SUGGEST=0.6
# PROMOTE_CORRECTIONS_AT=2
# FAKE_LLM=1
