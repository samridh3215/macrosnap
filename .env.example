# --- required in production ---
APP_TOKEN=change-me-to-a-long-random-string
PUBLIC_URL=https://your-domain.example

# --- Self-hosted store: SQLite file (used when no Couchbase is set) ---
# SQLITE_FILE=./data/macrosnap.db

# --- Couchbase Capella (optional hosted store) ---
COUCHBASE_CONNSTR=couchbases://cb.xxxxxxxx.cloud.couchbase.com
COUCHBASE_USERNAME=macrosnap
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=macrosnap
COUCHBASE_SCOPE=app

# --- Redis (omit to use an in-process cache) ---
REDIS_URL=rediss://default:password@host:6379

# --- OpenRouter (or paste a key in the app's Settings instead) ---
OPENROUTER_API_KEY=

# --- Strava (optional) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- tuning (optional) ---
# JUDGE=jev            # Jev judge for food matching (uses OPENROUTER_API_KEY); default off
# JEV_MODEL=typesafe/jev-1.13
# TOKENS=tokenA=samridh,tokenB=friend
# FUZZY_AUTO=0.9
# FUZZY_SUGGEST=0.6
# PROMOTE_CORRECTIONS_AT=2
# FAKE_LLM=1
