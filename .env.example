# Macro Snap settings. Copy this file to .env, then fill in the two lines under "Required".
# Everything else is optional; leave it commented out unless you need it.

# --- Required ---------------------------------------------------------------
# Your login. Make it long and random, e.g. run:  openssl rand -hex 24
APP_TOKEN=

# Your OpenRouter key (https://openrouter.ai/keys). Leave it empty to paste the key
# into the app's Settings instead, or to try the app with the fake AI (FAKE_LLM=1).
OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------------
# The public HTTPS address of your server. Only needed for Strava sign-in.
# PUBLIC_URL=https://your-machine.your-tailnet.ts.net

# Use the built-in fake AI instead of OpenRouter (no key, no cost, made-up results).
# FAKE_LLM=1

# Judge near-duplicate food names with Jev (uses your OpenRouter key). Off by default.
# JUDGE=jev
# JEV_MODEL=typesafe/jev-1.13

# More than one person on the same server: TOKENS=tokenA=alice,tokenB=bob
# (use instead of APP_TOKEN)
# TOKENS=

# Strava (https://www.strava.com/settings/api). Set the callback domain to your PUBLIC_URL's host.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Matching sensitivity. The defaults are fine.
# FUZZY_AUTO=0.9
# FUZZY_SUGGEST=0.6
# PROMOTE_CORRECTIONS_AT=2

# --- Advanced: not needed with docker compose --------------------------------
# docker compose already points the app at its SQLite file and its Redis cache.
# Running without Docker? Set the database file here:
# SQLITE_FILE=./data/macrosnap.db
# Optional cache (any redis:// or rediss:// URL). Without it the app uses an in-process cache.
# REDIS_URL=

# Couchbase Capella instead of SQLite. Not in the Docker image: run `npm i couchbase` first.
# If you set COUCHBASE_CONNSTR the app uses Capella and ignores SQLITE_FILE.
# COUCHBASE_CONNSTR=couchbases://cb.xxxxxxxx.cloud.couchbase.com
# COUCHBASE_USERNAME=macrosnap
# COUCHBASE_PASSWORD=
# COUCHBASE_BUCKET=macrosnap
# COUCHBASE_SCOPE=app

# --- Hosted multi-user mode (leave unset for self-hosting) ----------------------
# MODE=hosted                    # needs SQLITE_FILE, PUBLIC_URL, OPENROUTER_API_KEY; no APP_TOKEN/TOKENS
# SESSION_SECRET=                # random, 32+ characters
# GOOGLE_CLIENT_ID=              # Google Cloud OAuth client (web); redirect URI: $PUBLIC_URL/api/auth/google/callback
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=                # magic-link emails; without it links are printed to the server log
# EMAIL_FROM=Macro Snap <login@your-domain.example>
# LEMONSQUEEZY_CHECKOUT_URL=     # the $20/year variant's checkout link
# LEMONSQUEEZY_WEBHOOK_SECRET=   # webhook URL: $PUBLIC_URL/api/billing/webhook (subscription_* events)
# PRICE_LABEL=$20/year
# FREE_PHOTOS=30                 # AI logs on the platform key before paying
# FREE_AI_CAP_USD=1              # platform AI spend before paying, whichever runs out first
# PAID_AI_CAP_USD=10             # platform AI spend per paid user per rolling year
